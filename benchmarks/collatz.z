

proc collatz(int64 n) {
    int steps -> 0;
    
    for (int32 i -> 0 | n > 1 | steps + 1) {
        if (n % 2 == 0) {
            n -> n / 2;
        } else {
            n -> 3 * n + 1;
        }
    }
    ret steps;
}

proc main() {
    int64 max -> 0;
    int64 limit -> 1000000; 
    
    for (int64 i -> 1 | i < limit | i + 1) {
        int64 curr -> collatz(i);
        if (curr > max) {
            max -> curr;
        }
    }
    
    ret max;
}
