extern printf(str | ...) -> int32

proc collatzSteps(int64 start) -> int64 {
    int64 n -> start;
    int64 steps -> 0;

    for (int64 guard -> 0 | n > 1 | guard + 1) {
        int64 odd -> n % 2;
        if (odd == 0) {
            n -> n / 2;
        }
        if (odd == 1) {
            n -> 3 * n + 1;
        }
        steps -> steps + 1;
    }

    ret steps;
}

proc main(int32 argc) {
    int64 seed -> argc;
    int64 limit -> 1000000;
    int64 bestStart -> 0;
    int64 bestSteps -> 0;
    int64 total -> 0;

    for (int64 i -> 1 | i < limit | i + 1) {
        int64 s -> collatzSteps(i + seed - 1);
        if (s > bestSteps) {
            bestSteps -> s;
            bestStart -> i;
        }
        total -> total + s;
    }

    printf("%lld %lld %lld\n" | bestStart | bestSteps | total);
    ret 0;
}
