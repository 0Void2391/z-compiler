extern printf(str | ...) -> int32

proc collatz(uint64 n) -> int64 {
    int64 steps -> 0;

    for (int64 i -> 0 | n > 1 | i + 1) {
        if (n % 2 == 0) {
            n -> n / 2;
        } else {
            n -> 3 * n + 1;
        }
        steps -> steps + 1;
    }

    ret steps;
}

proc main() {
    uint64 limit -> 1000000;
    int64 max -> 0;
    int64 current -> 0;

    for (uint64 i -> 1 | i <= limit | i + 1) {
        current -> collatz(i);
        if (current > max) {
            max -> current;
        }
    }

    printf("%lld\n" | max);
    ret 0;
}
