extern printf(str | ...) -> int32

proc gcd(int64 a | int64 b) -> int64 {
    int64 x -> a;
    int64 y -> b;

    for (int64 guard -> 0 | y > 0 | guard + 1) {
        int64 r -> x % y;
        x -> y;
        y -> r;
    }

    ret x;
}

proc main(int32 argc) {
    int64 seed -> argc;
    int64 n -> 3500;
    int64 total -> 0;

    for (int64 i -> 1 | i < n + 1 | i + 1) {
        for (int64 j -> 1 | j < n + 1 | j + 1) {
            total -> total + gcd(i + seed - 1 | j);
        }
    }

    printf("%lld\n" | total);
    ret 0;
}
