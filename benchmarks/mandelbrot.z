extern printf(str | ...) -> int32

proc main() {
    int64 width -> 800;
    int64 height -> 600;
    int64 maxIter -> 256;
    int64 checksum -> 0;

    for (int64 y -> 0 | y < height | y + 1) {
        for (int64 x -> 0 | x < width | x + 1) {
            flt64 cr -> x * 3.0 / width - 2.0;
            flt64 ci -> y * 2.0 / height - 1.0;
            flt64 zr -> 0.0;
            flt64 zi -> 0.0;
            int64 iter -> 0;

            for (int64 k -> 0 | k < maxIter | k + 1) {
                if (zr * zr + zi * zi > 4.0) {
                    break;
                }

                flt64 nextR -> zr * zr - zi * zi + cr;
                zi -> 2.0 * zr * zi + ci;
                zr -> nextR;
                iter -> iter + 1;
            }

            checksum -> checksum + iter;
        }
    }

    printf("%lld\n" | checksum);
    ret 0;
}
