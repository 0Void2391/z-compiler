extern printf(str | ...) -> int32

proc main(int32 argc) {
    int64 seed -> argc;
    int64 state -> 12345 + seed;
    int64 modulus -> 2147483648;
    int64 samples -> 50000000;
    int64 hits -> 0;

    for (int64 i -> 0 | i < samples | i + 1) {
        state -> (state * 1103515245 + 12345) % modulus;
        flt64 x -> state * 1.0 / 2147483648.0;
        state -> (state * 1103515245 + 12345) % modulus;
        flt64 y -> state * 1.0 / 2147483648.0;

        if (x * x + y * y < 1.0) {
            hits -> hits + 1;
        }
    }

    printf("%lld\n" | hits);
    ret 0;
}
