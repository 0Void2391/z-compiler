extern printf(str | ...) -> int32

proc main(int32 argc) {
    int64 seed -> argc;
    int64 limit -> 1500000;
    int64 count -> 0;
    int64 last -> 0;

    for (int64 n -> 2 | n < limit | n + 1) {
        int64 m -> n + seed - 1;
        int64 prime -> 1;

        for (int64 d -> 2 | d * d < m + 1 | d + 1) {
            if (m % d == 0) {
                prime -> 0;
                break;
            }
        }

        if (prime == 1) {
            count -> count + 1;
            last -> m;
        }
    }

    printf("%lld %lld\n" | count | last);
    ret 0;
}
